# =============================================================
# 환경 / 로깅
# =============================================================
ENVIRONMENT=local
# 배포 시 production 으로 변경
LOG_LEVEL=DEBUG

# =============================================================
# 데이터베이스 (PostgreSQL + asyncpg)
# =============================================================
POSTGRES_DB=rown
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/rown

# =============================================================
# LLM providers — 모델 ID로 자동 라우팅 (src/clients/llm)
#   claude-* -> ANTHROPIC_API_KEY / gemini-* -> GEMINI_API_KEY / gpt-* -> OPENAI_API_KEY
# =============================================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================
# JWT 인증
# =============================================================
JWT_SECRET_KEY=change-me-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================
# SSO / 프론트엔드
# =============================================================
SAML_BASE_URL=change-me-domain
REACT_FRONTEND_URL=change-me-domain

# =============================================================
# 관리자 / 내부 API
# =============================================================
# INTERNAL_API_KEY: 서비스 내 사용할 API Key. JWT Secret Key와 동일하게 발급 후 설정
INTERNAL_API_KEY=change-me-32-chars-or-more
# SECRETS_ENCRYPTION_KEY: app_settings 시크릿(API키·네이버웍스 키 등) 암호화 전용 키(Fernet).
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비우면 JWT 키에서 파생 → JWT 로테이션 시 저장 시크릿 복호화 불가. 운영은 전용 키 권장.
SECRETS_ENCRYPTION_KEY=
# ORG_MONTHLY_COST_LIMIT_USD: 조직 월 비용 한도(USD). 관리자 대시보드 KPI·예산 경고 기준. 미설정 시 기본 3000
ORG_MONTHLY_COST_LIMIT_USD=3000

# =============================================================
# NAVER WORKS API (필수)
# NW로 시작하는 변수 모두 설정 필요. Developer Console -> API -> ClientApp에서 앱 추가 후 발급,
# OAuth Scopes에서 bot, bot.message, mail 선택
# =============================================================
NW_CLIENT_ID=your_client_id
NW_CLIENT_SECRET=your_client_secret
NW_SERVICE_ACCOUNT=serviceaccount@your-domain.worksmobile.com
# NW_PRIVATE_KEY: Private Key 발행 후 그대로 복사. 여러 줄로 인식 안 되면 줄바꿈 자리에 \n 직접 추가
NW_PRIVATE_KEY=change-me-RSA-private-key
# NW_BOT_ID: Developer Console -> Bot -> 등록하기에서 봇 생성 후 ID 입력. Admin -> 서비스 -> Bot에서 봇 추가
NW_BOT_ID=your_bot_id

# =============================================================
# 모델 경로 / 캐시 (아래 3개는 config 기본값 사용 — 필요 시 주석 해제해 오버라이드)
# =============================================================
HF_HOME=./cache/huggingface
# EMBEDDING_MODEL_PATH=./models/bge-m3-onnx-int8
# RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3-onnx-int8
# EXPORT_DIR=./exports

# =============================================================
# 원격 GPU 추론 (집 PC의 RTX 3060 Ti에 역방향 SSH 터널로 붙는다)
# =============================================================
# 주소가 172.17.0.1인 이유: 앱이 도커 컨테이너 안이라 호스트의 127.0.0.1로는
# 못 닿는다. 172.17.0.1(docker0)은 도커 데몬이 만들어 compose down에도 남는다.
# compose가 만드는 브리지(172.18.0.1)는 서브넷이 바뀔 수 있어 쓰지 않는다.
# 터널 쪽에는 sshd의 GatewayPorts clientspecified 가 필요하다.

# --- 리랭커: 비우면 로컬 CPU 모델을 쓴다 -----------------------------
# 점수는 순위 결정에만 쓰이고 저장되지 않아 원격/로컬 차이가 색인에 남지 않는다.
# RERANKER_REMOTE_URL=http://172.17.0.1:8009
# RERANKER_REMOTE_TOKEN=
# RERANKER_REMOTE_TIMEOUT_S=60
# local = 서버 CPU 모델로 재채점(품질 동일·서버 메모리 필요)
# passthrough = 재채점 생략(품질 소폭 하락·서버에서 모델 제거 가능)
# RERANKER_REMOTE_FALLBACK=local

# --- 임베딩: 켜기 전에 반드시 전량 재색인할 것 -----------------------
# 리랭커와 달리 벡터가 **색인에 저장된다**. 원격(fp16)과 기존 색인(CPU int8)이
# 다른 공간이면 질의와 색인이 어긋나 검색이 조용히 나빠진다 - 에러는 안 난다.
# scripts/reindex_embeddings.py 로 전부 다시 만든 뒤에 켠다.
# EMBEDDING_REMOTE_URL=http://172.17.0.1:8009
# EMBEDDING_REMOTE_TOKEN=
# EMBEDDING_REMOTE_TIMEOUT_S=60
# 한 요청에 보낼 텍스트 수. GPU 서비스의 GPU_MAX_PASSAGES 이하여야 한다.
# EMBEDDING_REMOTE_CHUNK=256
# local = 서버 CPU 모델(dtype이 달라 검색 품질이 조금 떨어질 수 있다)
# error = 실패를 드러낸다(조용한 품질 저하를 원치 않을 때)
# EMBEDDING_REMOTE_FALLBACK=local
