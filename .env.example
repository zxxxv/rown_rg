POSTGRES_DB=rown
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/rown
ANTHROPIC_API_KEY=sk-ant-...
LOG_LEVEL=DEBUG
JWT_SECRET_KEY=change-me-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=local # 배포 시 production로 변경
SAML_BASE_URL=change-me-domain
REACT_FRONTEND_URL=change-me-domain
INTERNAL_API_KEY=change-me-32-chars-or-more # 서비스 내 사용할 API Key, JWT Secret Key와 동일하게 발급 후 설정
NW_CLIENT_ID=your_client_id # NAVER WORKS Developer Console -> API -> ClientApp에서 앱 추가 후 발급, NW로 시작하는 변수 설정 필요, OAuth Scopes에서 bot, bot.message, mail 선택
NW_CLIENT_SECRET=your_client_secret
NW_SERVICE_ACCOUNT=serviceaccount@your-domain.worksmobile.com
NW_PRIVATE_KEY=change-me-RSA-private-key # Private Key 발행 후 그대로 복사, 여러 줄로 인식이 되지 않는 경우 줄바꿈 자리에 \n 직접 추가해야 함
NW_BOT_ID=your_bot_id # NAVER WORKS Developer Console -> Bot -> 등록하기에서 봇 생성 후 ID 입력, NAVER WORKS Admin -> 서비스 -> Bot -> Bot 추가에서 생성한 봇 추가


# 임베딩 모델 캐시 (HF Hub 다운로드 경로)
HF_HOME=./cache/huggingface
