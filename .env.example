# =============================================================
# 환경 / 로깅
# =============================================================
ENVIRONMENT=local
# 배포 시 production 으로 변경
LOG_LEVEL=DEBUG

# =============================================================
# 데이터베이스 (PostgreSQL + asyncpg)
# =============================================================
POSTGRES_DB=rown
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/rown

# =============================================================
# LLM providers — 모델 ID로 자동 라우팅 (src/clients/llm)
#   claude-* -> ANTHROPIC_API_KEY / gemini-* -> GEMINI_API_KEY / gpt-* -> OPENAI_API_KEY
# =============================================================
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================
# JWT 인증
# =============================================================
JWT_SECRET_KEY=change-me-32-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================
# SSO / 프론트엔드
# =============================================================
SAML_BASE_URL=change-me-domain
REACT_FRONTEND_URL=change-me-domain

# =============================================================
# 관리자 / 내부 API
# =============================================================
# INTERNAL_API_KEY: 서비스 내 사용할 API Key. JWT Secret Key와 동일하게 발급 후 설정
INTERNAL_API_KEY=change-me-32-chars-or-more
# ORG_MONTHLY_COST_LIMIT_USD: 조직 월 비용 한도(USD). 관리자 대시보드 KPI·예산 경고 기준. 미설정 시 기본 3000
ORG_MONTHLY_COST_LIMIT_USD=3000

# =============================================================
# NAVER WORKS API (필수)
# NW로 시작하는 변수 모두 설정 필요. Developer Console -> API -> ClientApp에서 앱 추가 후 발급,
# OAuth Scopes에서 bot, bot.message, mail 선택
# =============================================================
NW_CLIENT_ID=your_client_id
NW_CLIENT_SECRET=your_client_secret
NW_SERVICE_ACCOUNT=serviceaccount@your-domain.worksmobile.com
# NW_PRIVATE_KEY: Private Key 발행 후 그대로 복사. 여러 줄로 인식 안 되면 줄바꿈 자리에 \n 직접 추가
NW_PRIVATE_KEY=change-me-RSA-private-key
# NW_BOT_ID: Developer Console -> Bot -> 등록하기에서 봇 생성 후 ID 입력. Admin -> 서비스 -> Bot에서 봇 추가
NW_BOT_ID=your_bot_id

# =============================================================
# 모델 경로 / 캐시 (아래 3개는 config 기본값 사용 — 필요 시 주석 해제해 오버라이드)
# =============================================================
HF_HOME=./cache/huggingface
# EMBEDDING_MODEL_PATH=./models/bge-m3-onnx-int8
# RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3-onnx-int8
# EXPORT_DIR=./exports
