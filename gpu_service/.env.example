# GPU 박스에 gpu_service/.env 로 복사해서 채운다. 커밋하지 말 것.

# 앱과 나눠 갖는 공유 시크릿. 예: openssl rand -hex 32
GPU_TOKEN=

# 토큰 없이 띄우는 것은 로컬 실험에서만. 이 엔드포인트로 자료 본문이 오간다.
# GPU_ALLOW_ANON=1

# VRAM이 모자라면(3060 Ti 8GB에서 OOM) 낮춘다. 32 → 16 → 8.
GPU_BATCH_SIZE=32
GPU_MAX_LENGTH=512
GPU_MAX_PASSAGES=512
GPU_MAX_CONCURRENCY=1

# CPU 폴백/개발용으로 띄울 때 코어를 다 잡지 않게. 0 또는 미설정이면 코어 수 - 1.
# GPU_INTRA_OP_THREADS=2

# 임베딩 모델 경로. 비우면 /v1/embed 를 열지 않는다(리랭커 전용 배포로 쓸 수 있다).
# 8GB 카드에 리랭커와 함께 올리므로 fp32는 들어가지 않는다 - fp16을 쓴다.
# GPU_EMBED_MODEL_DIR=/models/bge-m3-onnx-fp16

# 한 forward의 누적 글자 수 상한. 비우면 **VRAM 여유분**에서 자동으로 고른다
# (시스템 RAM이 아니다 - 이 컨테이너의 제약은 VRAM이다).
# GPU_EMBED_MAX_CHARS=
