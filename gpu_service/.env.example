# GPU 박스에 gpu_service/.env 로 복사해서 채운다. 커밋하지 말 것.

# 앱과 나눠 갖는 공유 시크릿. 예: openssl rand -hex 32
GPU_TOKEN=

# 토큰 없이 띄우는 것은 로컬 실험에서만. 이 엔드포인트로 자료 본문이 오간다.
# GPU_ALLOW_ANON=1

# VRAM이 모자라면(3060 Ti 8GB에서 OOM) 낮춘다. 32 → 16 → 8.
GPU_BATCH_SIZE=32
GPU_MAX_LENGTH=512
GPU_MAX_PASSAGES=512
GPU_MAX_CONCURRENCY=1

# CPU 폴백/개발용으로 띄울 때 코어를 다 잡지 않게. 0 또는 미설정이면 코어 수 - 1.
# GPU_INTRA_OP_THREADS=2
